# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Исходники фотографий (JPEG с камеры, ~800 МБ).
# В репозиторий и в деплой попадают только сжатые WebP из public/images/fabrics.
/assets_src/Фото товара/
/public/images/Фото товара/
/public/images/ткань/
/public/images/Презентационные/

# Рабочие документы заказчика: товарная матрица, расписание перевозчиков,
# выгрузки Wordstat и семантика. Для сборки сайта они не нужны - данные из
# них перенесены в src/data. В репозитории им не место: он открыт, и любой
# желающий скачивал внутреннюю кухню KNK TEX вместе с кодом.
/docs/*.xlsx
/docs/*.xls
/docs/*.docx
/СЕО запросы/
/Транспортная/

